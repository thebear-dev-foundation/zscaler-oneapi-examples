# Zscaler OneAPI credentials — source locally before running scripts.
# Copy to .env and populate. Never commit .env.

# ZIdentity vanity domain — format: z-<orgid>.zslogin.net
# (NOT the -admin variant, which is the portal UI, not the token endpoint)
export ZS_VANITY_DOMAIN=z-XXXXXXXX.zslogin.net

# OneAPI OAuth2 client credentials (from ZIdentity admin portal)
# Scope to the minimum APIs your integration needs (read/write, per-product).
export ZS_CLIENT_ID=your-client-id-here
export ZS_CLIENT_SECRET=your-client-secret-here

# Default audience — leave as-is for standard OneAPI
export ZS_AUDIENCE=https://api.zscaler.com

# API base URL — usually api.zsapi.net; use api.beta.zsapi.net for beta tenants
export ZS_API_BASE_URL=https://api.zsapi.net
